{
  "name": "fulfillment",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "eslint . --max-warnings=0 && tsx scripts/check-no-cyrillic.ts",
    "format": "prettier --write .",
    "test": "vitest run && pnpm -r --workspace-concurrency=1 test",
    "test:int": "pnpm -r --workspace-concurrency=1 test:int",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "3.2.7",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-import-resolver-typescript": "4.4.4"
  }
}
