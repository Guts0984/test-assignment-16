{
  "name": "@ff/core",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run -c vitest.int.config.mts"
  },
  "dependencies": {
    "@ff/db": "workspace:*",
    "@ff/shared": "workspace:*",
    "@socket.io/redis-emitter": "5.1.0",
    "bullmq": "5.81.6",
    "ioredis": "5.11.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "@types/pg": "8.23.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "vitest": "3.2.7",
    "zod": "3.25.76"
  }
}
