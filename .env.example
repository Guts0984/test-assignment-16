# Fulfillment service configuration.
# Copy to .env:  cp .env.example .env
# Values marked SECRET are demo placeholders. Replace them outside local development.
# Every app parses this with zod in src/config/env.ts. Secrets have no defaults, so missing ones fail startup.

# ---------- runtime ----------
# production | development | test
NODE_ENV=production
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------- postgres ----------
POSTGRES_USER=fulfillment
# SECRET: database password
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fulfillment
# Host port where compose publishes postgres (for running tests from the host)
POSTGRES_HOST_PORT=25432
# SECRET: connection used from the host (tests, scripts). Compose builds its own internal URL from the values above.
DATABASE_URL=postgresql://fulfillment:change-me-postgres@127.0.0.1:25432/fulfillment
# SECRET: separate database for integration and adversarial tests (created automatically)
TEST_DATABASE_URL=postgresql://fulfillment:change-me-postgres@127.0.0.1:25432/fulfillment_test

# ---------- redis ----------
REDIS_HOST_PORT=26379
# SECRET (may carry credentials): Redis used from the host
REDIS_URL=redis://127.0.0.1:26379/0
# SECRET: Redis database for tests
TEST_REDIS_URL=redis://127.0.0.1:26379/1

# ---------- api ----------
API_PORT=3000
# Label of this api copy (a/b) in logs and health responses
API_INSTANCE_ID=local
# Prisma connection pool size per api process
DB_POOL_SIZE=30
# Mark the refresh cookie Secure (enable behind HTTPS)
COOKIE_SECURE=false
# SECRET: HMAC key for access tokens (>= 32 chars)
JWT_ACCESS_SECRET=change-me-access-secret-0123456789abcdef
# SECRET: HMAC key for refresh tokens (>= 32 chars)
JWT_REFRESH_SECRET=change-me-refresh-secret-0123456789abcdef
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600
# Seconds in which a just-rotated refresh token may be presented once more (two tabs refreshing at the same
# moment) and gets a fresh token instead of revoking the session. 0 = strict single use.
REFRESH_REUSE_GRACE_SEC=10
# SECRET: pepper for hashing shop API keys (>= 32 chars)
API_KEY_PEPPER=change-me-api-key-pepper-0123456789abcdef
# SECRET: base64 of 32 random bytes; encrypts per-shop webhook secrets at rest
WEBHOOK_SECRET_ENC_KEY=ZGVtby13ZWJob29rLWVuYy1rZXktMzItYnl0ZXMhISE=
# Comma-separated CORS allowlist
CORS_ORIGINS=http://localhost:8080
# Peers allowed to set X-Real-IP (nginx's fixed address on the compose network). Empty = trust nobody.
TRUSTED_PROXY_CIDRS=172.31.116.10/32
# Maximum request body in bytes (larger gets 413)
BODY_LIMIT_BYTES=1048576

# ---------- rate limits (per window) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_PER_IP=60
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
# Cap on logins for one account from ALL addresses together (guess budget against distributed attacks)
RATE_LIMIT_LOGIN_PER_ACCOUNT_TOTAL=100
RATE_LIMIT_GENERAL_PER_IP=6000
RATE_LIMIT_SHOP_API_PER_KEY=3000
RATE_LIMIT_SHOP_API_PER_IP=3000
RATE_LIMIT_SCAN_PER_STAFF=600
RATE_LIMIT_SOCKET_MSG_PER_SEC=20

# ---------- realtime / dashboard ----------
SOCKET_PRESENCE_TTL_SEC=30
AT_RISK_THRESHOLD_MIN=60

# ---------- test hooks (never enable in production) ----------
TEST_CLOCK_ENABLED=false
# SECRET: required when TEST_CLOCK_ENABLED=true or SHOP_STUB_CONTROL_ENABLED=true
TEST_CONTROL_TOKEN=change-me-test-control-token

# ---------- worker ----------
WORKER_CONCURRENCY=5
WORKER_REPLICAS=3
RECONCILE_INTERVAL_MS=1000
JOB_LEASE_MS=30000
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_MS=1000
WAVE_INTERVAL_MIN=15
WAVE_READY_THRESHOLD=50
WAVE_MAX_ORDERS=200
PARTIAL_RESERVE_TTL_MIN=2880
NIGHTLY_LOCAL_TIME=02:00

# ---------- webhooks ----------
WEBHOOK_COALESCE_MS=5000
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_BACKOFF_BASE_MS=1000
WEBHOOK_BACKOFF_MAX_MS=60000
# The demo shop stub lives on the private docker network, so private hosts are allowed here.
WEBHOOK_ALLOW_PRIVATE_HOSTS=true

# ---------- seed ----------
# small (tests, CI) | full (assignment volumes; default for docker compose up)
SEED_PROFILE=full
# SECRET: password of every seeded user (listed in README)
SEED_DEMO_PASSWORD=demo-password-123
# SECRET: derives the seeded shop API keys (README lists the keys for this value)
SEED_API_KEY_SALT=demo-api-key-salt
# SECRET: derives the seeded shops' webhook secrets (the shop stub uses the same salt)
SEED_WEBHOOK_SECRET_SALT=demo-webhook-secret-salt
# Where seeded shops send webhooks (the shop stub inside compose)
SEED_WEBHOOK_BASE_URL=http://shop-stub:4000

# ---------- web ----------
WEB_PORT=3001
# Server-side API base used by Next (inside the compose network)
API_INTERNAL_URL=http://nginx/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# ---------- nginx ----------
NGINX_HOST_PORT=8080

# ---------- shop stub ----------
SHOP_STUB_PORT=4000
SHOP_STUB_HOST_PORT=24000
SHOP_STUB_API_URL=http://nginx/api
SHOP_STUB_API_A_URL=http://api-a:3000/api
SHOP_STUB_API_B_URL=http://api-b:3000/api
# Chaos mode: duplicate orders to both api copies, every 5th webhook fails, random instant cancels
SHOP_STUB_CHAOS=false
SHOP_STUB_CHAOS_CANCEL_RATE=0.1
SHOP_STUB_CHAOS_SEED=42
SHOP_STUB_CONTROL_ENABLED=false
SHOP_STUB_WEBHOOK_MAX_SKEW_SEC=300

# ---------- e2e ----------
E2E_BASE_URL=http://localhost:8080
